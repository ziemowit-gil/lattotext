# Klucz Claude API (console.anthropic.com → API Keys). Można go też wpisać w panelu admina.
ANTHROPIC_API_KEY=
# Ścieżka do Node dla serwera WWW (gdy PHP nie widzi node w PATH, np. przy nvm)
NODE_BIN=/usr/bin/node
# Opcjonalnie: hasło skrzynki IMAP, jeśli nie jest ustawione w panelu admina
IMAP_PASSWORD=
